OCR_MODE=off
OCR_BACKEND=gcv
OCR_ZOOM=2.0

# Leave API_KEY empty to keep the extraction endpoints open (the previous
# behaviour). Set it and callers must send a matching X-API-Key header.
API_KEY=

# /v1/extract/url refuses loopback, link-local and RFC1918 addresses.
# Turn this on only to fetch PDFs from inside your own network.
ALLOW_PRIVATE_URLS=false

MAX_UPLOAD_MB=50
MAX_DOWNLOAD_MB=50

# Content-addressed cache. Keyed on the PDF's own bytes, so re-running the same
# document is free -- including per-page OCR, the only part that costs money.
CACHE_ENABLED=true
# CACHE_DIR=backend/.cache
CACHE_MAX_MB=512

# In ocr_mode=auto, a page with fewer than this many characters is treated as
# having no usable text layer and gets OCR'd.
AUTO_OCR_MIN_CHARS=16

# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
